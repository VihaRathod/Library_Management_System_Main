DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@host.docker.internal:5432/Library_Management_System

SECRET_KEY=YOUR_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

LOAN_DURATION_DAYS=14

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=library@example.com

OVERDUE_REMINDER_HOUR=13
OVERDUE_REMINDER_MINUTE=15